# =============================================================================
# VIXART OS — environment variables
#
# Copy to `.env`, then replace every `CHANGE_ME` value.
# Generate a strong secret:   openssl rand -base64 32
#
# ⚠️  `.env` is never committed. It holds the database passwords. Losing it
#     causes no data loss (the data lives in the `vixart_pgdata` volume) but the
#     application will not start: keep a copy off the server.
# =============================================================================

# --- PostgreSQL: owner role (migrations, seed, backups) ---------------------
POSTGRES_DB=vixart
POSTGRES_USER=vixart_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
POSTGRES_PORT=5432

# --- PostgreSQL: application role (subject to row level security) -----------
# This role can neither create nor drop a table, and does not bypass RLS.
APP_DB_USER=vixart_app
APP_DB_PASSWORD=CHANGE_ME_application_password

# --- Connection URLs (host `db` = the docker-compose service name) ----------
DATABASE_URL=postgres://vixart_owner:CHANGE_ME_owner_password@db:5432/vixart
APP_DATABASE_URL=postgres://vixart_app:CHANGE_ME_application_password@db:5432/vixart

# --- Application ------------------------------------------------------------
APP_PORT=4000
TZ=Africa/Casablanca
# Auth.js session signing secret — openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_session_secret

# Initial password for the five team accounts, set by the seed.
# Each member must change it at first sign-in — the application blocks
# everything else until they do.
SEED_DEFAULT_PASSWORD=CHANGE_ME_initial_password

# --- Backups ----------------------------------------------------------------
# Hour of the nightly backup (0-23), Casablanca time.
BACKUP_HOUR=3
# Number of backups kept. Beyond that, the oldest is deleted.
BACKUP_RETENTION=30
