# =============================================================================
# VIXART OS — variables d'environnement
#
# Copier en `.env` puis remplacer TOUTES les valeurs « CHANGER_MOI ».
# Générer un secret solide :   openssl rand -base64 32
#
# ⚠️  Le fichier `.env` n'est jamais committé. Il contient les mots de passe de
#     la base. Le perdre n'entraîne aucune perte de données (les données sont
#     dans le volume `vixart_pgdata`), mais empêche l'application de démarrer :
#     en garder une copie hors serveur.
# =============================================================================

# --- PostgreSQL : rôle propriétaire (migrations, seed, sauvegardes) ----------
POSTGRES_DB=vixart
POSTGRES_USER=vixart_owner
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_proprietaire
POSTGRES_PORT=5432

# --- PostgreSQL : rôle applicatif (soumis au Row Level Security) ------------
# Ce rôle ne peut ni créer ni supprimer de table, et ne contourne pas le RLS.
APP_DB_USER=vixart_app
APP_DB_PASSWORD=CHANGER_MOI_mot_de_passe_application

# --- URLs de connexion (hôte `db` = nom du service docker-compose) ----------
DATABASE_URL=postgres://vixart_owner:CHANGER_MOI_mot_de_passe_proprietaire@db:5432/vixart
APP_DATABASE_URL=postgres://vixart_app:CHANGER_MOI_mot_de_passe_application@db:5432/vixart

# --- Application ------------------------------------------------------------
APP_PORT=3000
TZ=Africa/Casablanca
# Secret de signature des sessions Auth.js — openssl rand -base64 32
AUTH_SECRET=CHANGER_MOI_secret_de_session

# Mot de passe initial des cinq comptes de l'équipe, posé par le seed.
# À changer par chaque membre à la première connexion.
SEED_DEFAULT_PASSWORD=CHANGER_MOI_mot_de_passe_initial

# --- Sauvegardes ------------------------------------------------------------
# Heure de la sauvegarde quotidienne (0-23), heure de Casablanca.
BACKUP_HOUR=3
# Nombre de sauvegardes conservées. Au-delà, la plus ancienne est supprimée.
BACKUP_RETENTION=30
